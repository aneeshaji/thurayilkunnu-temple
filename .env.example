# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Optional: override the contact endpoint path. Defaults to /api/contact,
# which is where the Nodemailer server in /server is mounted.
# VITE_CONTACT_API_URL=/api/contact

# Optional: Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
# Leave blank to keep analytics disabled.
VITE_GA_MEASUREMENT_ID=
