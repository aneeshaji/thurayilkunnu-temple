# Copy to `.env` for local testing. In production set these in the
# cPanel Node.js App "Environment variables" panel — never commit real values.

# Port is assigned by cPanel / Passenger in production
PORT=3000

# Destination mailbox for all contact form submissions
MAIL_TO=info@thurayilkunnutemple.com

# Sender identity. Must be a Gmail/Workspace account you control, or one
# verified in the SMTP provider. Keep the same as MAIL_USER for Google.
MAIL_FROM=info@thurayilkunnutemple.com
MAIL_FROM_NAME=Thurayilkunnu Temple Website
MAIL_SUBJECT_PREFIX=[Temple Enquiry]

# Google Workspace / Gmail SMTP
# Use a Google App Password, not the account password.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@thurayilkunnutemple.com
SMTP_PASS=your-16-char-google-app-password

# Submissions allowed per IP per 15 minutes
RATE_LIMIT_MAX=8
